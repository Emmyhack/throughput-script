# HTTP JSON-RPC endpoint of the node to benchmark (e.g. a local Konstellation node)
RPC_URL=http://127.0.0.1:8545
# Optional. If set, the script refuses to run when the node reports a different chain id.
CHAIN_ID=
# Funded account used to fund the worker accounts. Never use a mainnet key here.
PRIVATE_KEY=0x...

# load mode
TX_COUNT=1000        # total native transfers to send
CONCURRENCY=20       # number of derived worker accounts sending in parallel
TIMEOUT_SEC=120      # give up waiting for inclusion after this long
FEE_MULTIPLIER=2     # fee cap = baseFee * multiplier + priority tip

# observe mode
BLOCKS=50            # how many recent blocks to sample
